# Admin login — copy to .env.local and fill in. Generate the hash and secret with:
#   npm run admin:hash
# Restart the server after changing these. If any value is missing, /admin stays locked.

ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=scrypt:16384:8:1:<salt>:<hash>
# At least 32 characters. Changing it signs out every admin session.
SESSION_SECRET=<random-string>
# Optional: name shown in the admin header (defaults to ADMIN_USERNAME).
ADMIN_DISPLAY_NAME=

# Set to 1 only when running behind a reverse proxy (nginx, Cloudflare…) that sets
# X-Forwarded-For — enables per-IP login rate limiting instead of a shared limit.
# TRUST_PROXY=1

# Optional: where the JSON store lives (defaults to ./data).
# STORE_DATA_DIR=
