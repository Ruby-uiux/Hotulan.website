# Admin login — copy to .env.local and fill in. Generate the hash and secret with:
#   npm run admin:hash
#
# Staff sign in with accounts from the database (staff table). ADMIN_USERNAME /
# ADMIN_PASSWORD_HASH are read ONCE: on startup, while no staff member has a password,
# they become the first super admin. After that, editing them here changes nothing.

ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=scrypt:16384:8:1:<salt>:<hash>
# Optional: display name for that first super admin (defaults to ADMIN_USERNAME).
ADMIN_DISPLAY_NAME=
# Required. At least 32 characters; without it /admin stays locked. Changing it signs
# out every session. Also keys the hashes of SMS login codes.
SESSION_SECRET=<random-string>

# Set to 1 only when running behind a reverse proxy (nginx, Cloudflare…) that sets
# X-Forwarded-For. Enables per-IP limits: login (5 failures / 15 min instead of one shared
# limit) and checkout (5 orders / 10 min per IP). Without it checkout is limited per phone
# number only — the IP header could otherwise be faked by the client.
# TRUST_PROXY=1

# Optional: minutes an unpaid QPay order holds its stock before it is auto-cancelled (default 30).
# QPAY_RESERVATION_MINUTES=30
# Optional: hours staff have to confirm a cash-on-delivery order before it is auto-cancelled (default 24).
# COD_CONFIRM_HOURS=24

# NODE_ENV=production (set by `next start`) disables demo data: a new database gets
# categories, zones and settings only, and "reset demo data" (/api/admin/reset) is gone.

# Optional: data folder for the SQLite file (defaults to ./data → ./data/hotulan.db).
# STORE_DATA_DIR=
# Optional: full database URL instead (e.g. file:/srv/hotulan/hotulan.db, or a libSQL/Turso URL).
# DATABASE_URL=
# DATABASE_AUTH_TOKEN=

# Optional: folder for uploaded images (defaults to ./public/uploads, served at /uploads/…).
# UPLOADS_DIR=

# Public address of the store, for canonical links, Open Graph, sitemap.xml and robots.txt.
# SITE_URL=https://hotulan.mn
